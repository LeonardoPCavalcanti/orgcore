# Copie para api/.env (ignorado pelo git). Os testes e o servidor de
# desenvolvimento carregam este arquivo automaticamente.
DATABASE_URL=postgres://4med:desenvolvimento@localhost:5433/4med

# Assina os cookies de sessão. Em produção, troque por 32 bytes aleatórios.
COOKIE_SECRET=troque-por-32-bytes-aleatorios-em-producao

# Origem do front liberada no CORS (padrão: Vite em dev).
WEB_ORIGIN=http://localhost:5173

# Freio de custo das IAs gratuitas (opt-in). Cada teto: 0 ou ausente = SEM limite.
# Recomendado ao expor a demo ao público, para estranhos não queimarem as cotas.
#   IA_LIMITE_REQS_USUARIO_DIA   -> nº de mensagens de IA por usuário por dia
#   IA_LIMITE_TOKENS_USUARIO_DIA -> tokens por usuário por dia
#   IA_LIMITE_TOKENS_GLOBAL_DIA  -> tokens somados de toda a plataforma por dia
IA_LIMITE_REQS_USUARIO_DIA=0
IA_LIMITE_TOKENS_USUARIO_DIA=0
IA_LIMITE_TOKENS_GLOBAL_DIA=0

# Rate limit de rajada por IP (opt-in). 0 ou ausente = desligado. Freio de
# enxurrada de requisições e de força-bruta no login.
#   RATE_LIMIT_GERAL_POR_MIN -> requisições por IP por minuto (todas as rotas)
#   RATE_LIMIT_LOGIN_POR_MIN -> tentativas de POST /auth/login por IP por minuto
RATE_LIMIT_GERAL_POR_MIN=0
RATE_LIMIT_LOGIN_POR_MIN=0

# Geração de conteúdo por IA. SEM LLM_API_KEY, o módulo usa o gerador fake
# determinístico (útil para dev/CI). Com a chave, usa a IA real via API gratuita
# compatível com OpenAI (padrão: Groq — crie uma chave em console.groq.com).
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
# Padrão: 8B — rápido e com limites de tier grátis mais folgados.
# Recomendado p/ qualidade: llama-3.3-70b-versatile (legendas melhores, segue melhor o
# prompt; limites do tier grátis um pouco mais apertados). O few-shot dos aprovados
# também eleva a qualidade em qualquer modelo.
LLM_MODELO=llama-3.1-8b-instant

# Provedores multi-IA (catálogo). Cada um LIGA quando a chave dele existe. A Groq também
# aceita o LLM_API_KEY acima. Modelo por provedor pode ser sobreposto com <ID>_MODELO.
GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
SAMBANOVA_API_KEY=
MISTRAL_API_KEY=
NVIDIA_API_KEY=

# Pipeline de imagem das fotos (pacotes nativos opcionais). SEM as flags, roda o
# passthrough (padrão em CI/teste, determinístico). Ligue depois de instalar os pacotes:
#   RECORTE_FUNDO=true  ->  pnpm --filter @4med/api add @imgly/background-removal-node
#   REALCE_FOTO=true    ->  pnpm --filter @4med/api add sharp
RECORTE_FUNDO=false
REALCE_FOTO=false

# Publicação no Instagram (Instagram Graph API). SEM as duas, o publicador fica inerte
# (não publica). Preencha com o token de longa duração e o ID da conta comercial.
IG_TOKEN=
IG_USER_ID=
