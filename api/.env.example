# Copie para api/.env (ignorado pelo git). Os testes e o servidor de
# desenvolvimento carregam este arquivo automaticamente.
DATABASE_URL=postgres://4med:desenvolvimento@localhost:5433/4med

# Assina os cookies de sessão. Em produção, troque por 32 bytes aleatórios.
COOKIE_SECRET=troque-por-32-bytes-aleatorios-em-producao

# Origem do front liberada no CORS (padrão: Vite em dev).
WEB_ORIGIN=http://localhost:5173
